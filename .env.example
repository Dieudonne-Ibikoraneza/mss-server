# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
# Where links in emails (e.g. "your quotation is ready") point back to.
CLIENT_URL=http://localhost:3000

# --- Database (Postgres) ---
# Fill in once the database is created. Prisma reads this connection string.
# If you're on Supabase (or any pgbouncer-pooled connection), DATABASE_URL
# should point at the pooled port (usually 6543) with ?pgbouncer=true, and
# DIRECT_URL should point at the direct/session port (usually 5432) since
# `prisma migrate` needs a non-pooled connection to run DDL.
DATABASE_URL=postgresql://magnificat:magnificat@localhost:5432/magnificat_smart_space?schema=public
DIRECT_URL=postgresql://magnificat:magnificat@localhost:5432/magnificat_smart_space?schema=public

# --- Redis (cache, rate limiting, OTP storage, sessions, queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# --- OTP ---
# 4 digits to match the frontend's 4-box OTP input.
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Rate limiting (requests / window in ms) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Orders ---
# How long a newly-placed order holds its stock before auto-cancelling if
# payment hasn't been verified (and it hasn't otherwise moved off PENDING).
ORDER_RESERVATION_MINUTES=60

# --- Notifications providers ---
# EMAIL_PROVIDER: "console" (logs the email instead of sending — good for local dev)
# or "smtp" (sends for real via the settings below).
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your Gmail address>,
# SMTP_PASSWORD=<a 16-char App Password from https://myaccount.google.com/apppasswords —
# NOT your regular Gmail password, and only issuable once 2-Step Verification is on>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must match SMTP_USER (or a verified alias) or Gmail will reject/flag it as spoofed.
# Format: "Display Name" <address@example.com>
SMTP_FROM=
SMS_API_KEY=
SMS_SENDER_ID=MAGNIFICAT

# --- Payments ---
MOMO_API_BASE_URL=
MOMO_API_KEY=
MOMO_API_USER=
MOMO_SUBSCRIPTION_KEY=
CARD_PROVIDER_API_BASE_URL=
CARD_PROVIDER_SECRET_KEY=

# --- AI providers (chatbot, image/video mockups) ---
# AI_CHAT_PROVIDER: "stub" (canned replies, no external calls) or "gemini" (real Google Gemini API).
AI_CHAT_PROVIDER=stub
AI_CHAT_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_IMAGE_PROVIDER=stub
AI_IMAGE_API_KEY=
AI_VIDEO_PROVIDER=stub
AI_VIDEO_API_KEY=

# --- File storage (product images, room designs, chat media) ---
# Product images are uploaded to the Supabase Storage bucket named "Products".
STORAGE_DRIVER=supabase
STORAGE_LOCAL_PATH=./uploads
SUPABASE_PROJECT_ID=yinatdmepjyfvqjekbjp
SUPABASE_URL=https://yinatdmepjyfvqjekbjp.supabase.co
# Server-side secret; never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
