# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
# Where links in emails (e.g. "your quotation is ready") point back to.
CLIENT_URL=http://localhost:3000

# --- API docs (Swagger UI at /docs) ---
# On by default outside production; OFF by default in production. To serve it
# in production set SWAGGER_ENABLED=true AND credentials (HTTP Basic auth is
# then enforced; the password must be at least 12 characters). Credentials are
# optional in development and, when set, protect the docs there too.
# SWAGGER_ENABLED=false
# SWAGGER_USER=
# SWAGGER_PASSWORD=

# --- Database (Postgres) ---
# Fill in once the database is created. Prisma reads this connection string.
# If you're on Supabase (or any pgbouncer-pooled connection), DATABASE_URL
# should point at the pooled port (usually 6543) with ?pgbouncer=true, and
# DIRECT_URL should point at the direct/session port (usually 5432) since
# `prisma migrate` needs a non-pooled connection to run DDL.
DATABASE_URL=postgresql://magnificat:magnificat@localhost:5432/magnificat_smart_space?schema=public
DIRECT_URL=postgresql://magnificat:magnificat@localhost:5432/magnificat_smart_space?schema=public

# --- Redis (response cache, rate limiting, OTP storage) — OPTIONAL ---
# Leave REDIS_URL unset/empty to run with no Redis at all (e.g. a free hosting tier): OTP codes and
# pending registrations are kept in Postgres (table "KeyValueEntry"), rate-limit counters live in
# the API process's memory, and the response cache is off so every request reads Postgres.
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# --- Session cookie ---
# The refresh token is delivered as a Secure/HttpOnly/SameSite cookie; the web
# app keeps the short-lived access token in memory only. Defaults are right for
# a web app and API on the same site (same registrable domain, or localhost on
# different ports). COOKIE_SECURE defaults to true in production.
# Only if the web app and API sit on entirely different sites, use
#   COOKIE_SAMESITE=none  (requires COOKIE_SECURE=true)
# COOKIE_SECURE=
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- OTP ---
# 4 digits to match the frontend's 4-box OTP input.
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Rate limiting (requests / window in ms) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Orders ---
# How long a newly-placed order holds its stock before auto-cancelling if
# payment hasn't been verified (and it hasn't otherwise moved off PENDING).
ORDER_RESERVATION_MINUTES=60

# --- Notifications providers ---
# EMAIL_PROVIDER: "console" (logs the email instead of sending — good for local dev)
# or "smtp" (sends for real via the settings below).
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your Gmail address>,
# SMTP_PASSWORD=<a 16-char App Password from https://myaccount.google.com/apppasswords —
# NOT your regular Gmail password, and only issuable once 2-Step Verification is on>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must match SMTP_USER (or a verified alias) or Gmail will reject/flag it as spoofed.
# Format: "Display Name" <address@example.com>
SMTP_FROM=
SMS_API_KEY=
SMS_SENDER_ID=MAGNIFICAT

# --- AI providers (chatbot, image/video mockups) ---
# AI_CHAT_PROVIDER: "stub" (canned replies, no external calls) or "gemini" (real Google Gemini API).
AI_CHAT_PROVIDER=stub
AI_CHAT_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_IMAGE_PROVIDER=stub
AI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
AI_VIDEO_PROVIDER=stub
AI_VIDEO_API_KEY=

# --- Translation (auto-translating dynamic content — product names,
# collection/room copy, knowledge-base entries — into Kinyarwanda) ---
# TRANSLATE_PROVIDER: "stub" (leaves the rw fields empty, no external calls)
# or "google" (real Google Cloud Translation API v2).
TRANSLATE_PROVIDER=stub
# From https://console.cloud.google.com/apis/credentials, with the Cloud
# Translation API enabled on the project.
GOOGLE_TRANSLATE_API_KEY=

# --- File storage (product images, room designs, chat media) ---
# Product images are uploaded to the Supabase Storage bucket named "Products".
STORAGE_DRIVER=supabase
STORAGE_LOCAL_PATH=./uploads
SUPABASE_PROJECT_ID=yinatdmepjyfvqjekbjp
SUPABASE_URL=https://yinatdmepjyfvqjekbjp.supabase.co
# Server-side secret; never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- OTP test bypass ---
# OTP_DEV_BYPASS_CODE (default 1234) verifies for ANY account, so it is ignored when
# NODE_ENV=production. To use it on a deployed instance that is still being tested (and can't send
# real codes yet), also set OTP_ALLOW_BYPASS_IN_PRODUCTION=true. Never leave that on for real users.
# OTP_ALLOW_BYPASS_IN_PRODUCTION=true
