# Docker Compose settings. The application also receives this file at runtime.
BACKEND_NETWORK=magnificat-backend
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=4000

# Your separately managed PostgreSQL instance. Use its network alias, not localhost.
DATABASE_URL=postgresql://magnificat:replace-me@magnificat-postgres:5432/magnificat_smart_space?schema=public
DIRECT_URL=postgresql://magnificat:replace-me@magnificat-postgres:5432/magnificat_smart_space?schema=public
# For pooled connections, DIRECT_URL must use the non-pooled migration endpoint.
REDIS_URL=redis://redis:6379

# Browser-facing HTTPS frontend origin, also used in email links.
CORS_ORIGINS=https://app.example.com
CLIENT_URL=https://app.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Generate two different values with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SWAGGER_ENABLED=false

# Separately deployed storage/ project, on the same backend network.
STORAGE_DRIVER=minio
MINIO_ENDPOINT=magnificat-minio
# Container port, not storage/.env's host port (9002).
MINIO_API_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=magnificat-storage
MINIO_SECRET_KEY=
MINIO_BUCKET=magnificat-smart-space
MINIO_REGION=us-east-1

# Fill provider settings here, or copy the relevant values from .env.example.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
AI_CHAT_PROVIDER=stub
AI_IMAGE_PROVIDER=stub
AI_VIDEO_PROVIDER=stub
TRANSLATE_PROVIDER=stub
